#!/bin/bash
# netns 初期化スクリプト (root で実行される)
# sandbox から sudo 経由で呼び出される。直接実行しないこと。
set -euo pipefail

NS_NAME=ai-ns
VETH_HOST=veth-host
VETH_AI=veth-ai
HOST_IP=10.200.1.1/24
AI_IP=10.200.1.2/24
HOST_GATEWAY=10.200.1.100
if [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
  _HOME="/home/$SUDO_USER"
else
  _HOME="$HOME"
fi
PROFILES_DIR="${PROFILES_DIR:-$_HOME/.local/share/my-tasks/proxy-profiles}"

# proxy-profiles からポート番号を収集
PROXY_PORTS=()
if [[ -d "$PROFILES_DIR" ]]; then
  for profile_json in "$PROFILES_DIR"/*.json; do
    [[ -f "$profile_json" ]] || continue
    port=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['port'])" "$profile_json" 2>/dev/null || true)
    if [[ -n "$port" ]]; then
      PROXY_PORTS+=("$port")
    fi
  done
fi

# フォールバック: プロファイルが読めない場合はデフォルトポート 3128
if [[ ${#PROXY_PORTS[@]} -eq 0 ]]; then
  PROXY_PORTS=(3128)
fi

# 1. netns 作成
ip netns add "$NS_NAME"

# 2. veth ペア作成
ip link add "$VETH_HOST" type veth peer name "$VETH_AI"
ip link set "$VETH_AI" netns "$NS_NAME"

# ホスト側 IP 設定
ip addr add "$HOST_IP" dev "$VETH_HOST"
ip link set "$VETH_HOST" up

# ai-ns 側 IP 設定
ip netns exec "$NS_NAME" ip addr add "$AI_IP" dev "$VETH_AI"
ip netns exec "$NS_NAME" ip link set "$VETH_AI" up
ip netns exec "$NS_NAME" ip link set lo up

# 3. デフォルトルート
ip netns exec "$NS_NAME" ip route add default via "${HOST_IP%/*}"

# 4. IP フォワード有効化
sysctl -w net.ipv4.ip_forward=1 >/dev/null

# 4b. route_localnet 有効化 (veth 経由の 127.0.0.0/8 パケットを許可)
sysctl -w net.ipv4.conf."$VETH_HOST".route_localnet=1 >/dev/null
ip netns exec "$NS_NAME" sysctl -w net.ipv4.conf."$VETH_AI".route_localnet=1 >/dev/null

# 5. HOST_GATEWAY: ホスト localhost へのゲートウェイ IP
ip addr add "${HOST_GATEWAY}/32" dev "$VETH_HOST"

# 6. NAT (nftables masquerade)
DEFAULT_IF=$(ip route | awk '/^default/{print $5; exit}')
if [[ -z "$DEFAULT_IF" ]]; then
  echo "error: デフォルトインターフェースが見つかりません" >&2
  exit 1
fi
nft add table ip nat
nft 'add chain ip nat postrouting { type nat hook postrouting priority 100 ; }' 2>/dev/null || true
nft add rule ip nat postrouting oifname "$DEFAULT_IF" masquerade
nft 'add chain ip nat prerouting { type nat hook prerouting priority -100 ; }' 2>/dev/null || true

# HOST_GATEWAY → 127.0.0.1 一括 DNAT (全ポート)
nft add rule ip nat prerouting iifname "$VETH_HOST" ip daddr "$HOST_GATEWAY" dnat to 127.0.0.1

# 7. DNS リスナー (systemd-resolved を 10.200.1.1 でも待ち受け)
RESOLVED_DROPIN_DIR=/etc/systemd/resolved.conf.d
RESOLVED_DROPIN="$RESOLVED_DROPIN_DIR/ai-sandbox.conf"
if [[ ! -f "$RESOLVED_DROPIN" ]]; then
  mkdir -p "$RESOLVED_DROPIN_DIR"
  cat > "$RESOLVED_DROPIN" <<EOF
[Resolve]
DNSStubListenerExtra=${HOST_IP%/*}
EOF
  systemctl restart systemd-resolved
fi

# 8. ai-ns 内 outbound 制限
ip netns exec "$NS_NAME" nft add table inet filter
ip netns exec "$NS_NAME" nft 'add chain inet filter output { type filter hook output priority 0 ; policy drop ; }'
ip netns exec "$NS_NAME" nft add rule inet filter output oifname "lo" accept
ip netns exec "$NS_NAME" nft add rule inet filter output ip daddr "${HOST_IP%/*}" udp dport 53 accept
ip netns exec "$NS_NAME" nft add rule inet filter output ip daddr "${HOST_IP%/*}" tcp dport 53 accept
for proxy_port in "${PROXY_PORTS[@]}"; do
  ip netns exec "$NS_NAME" nft add rule inet filter output ip daddr "${HOST_IP%/*}" tcp dport "$proxy_port" accept
done

# HOST_GATEWAY 宛の全通信を許可 (ホスト localhost へのアクセス)
ip netns exec "$NS_NAME" nft add rule inet filter output ip daddr "$HOST_GATEWAY" accept

# SSH 許可 (GitHub / Bitbucket)
for domain in github.com bitbucket.org; do
  ips=$(dig +short "$domain" A 2>/dev/null || true)
  if [[ -n "$ips" ]]; then
    while IFS= read -r ip; do
      ip netns exec "$NS_NAME" nft add rule inet filter output ip daddr "$ip" tcp dport 22 accept
    done <<< "$ips"
  fi
done
